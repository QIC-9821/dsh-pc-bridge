{
  "name": "dsh-pc-bridge",
  "version": "0.1.1",
  "description": "Loopback HTTP bridge that lets a peer machine ping and run shell commands on this PC, plus an optional ssh reverse-tunnel supervisor.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "bin": {
    "pcctl": "./bin/pcctl.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "bin/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "test/",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "bridge",
    "remote-exec",
    "ssh-tunnel",
    "security"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "QIC-9821",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIC-9821/dsh-pc-bridge.git"
  },
  "homepage": "https://github.com/QIC-9821/dsh-pc-bridge#readme",
  "bugs": {
    "url": "https://github.com/QIC-9821/dsh-pc-bridge/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
